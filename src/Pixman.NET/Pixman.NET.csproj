<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <PixmanIncludeAppleTargets Condition="'$(PixmanIncludeAppleTargets)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</PixmanIncludeAppleTargets>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PixmanIncludeAppleTargets)' == 'true'">$(TargetFrameworks);net10.0-ios26.0;net10.0-tvos26.0;net10.0-maccatalyst26.0</TargetFrameworks>
    <RootNamespace>Pixman</RootNamespace>
    <AssemblyName>pixman-dotnet</AssemblyName>
    <PackageId>pixman-dotnet</PackageId>
    <Description>.NET bindings for pixman</Description>
    <PackageTags>pixman;compositing;raster;graphics;cairo;x11;wayland;interop;bindings</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <RuntimesDir>$(MSBuildThisFileDirectory)../../runtimes/</RuntimesDir>
    <XcframeworksDir>$(MSBuildThisFileDirectory)../../xcframeworks/</XcframeworksDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(RuntimesDir)**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(XcframeworksDir)**/*" Pack="true" PackagePath="xcframeworks/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="buildTransitive/**" />
    <None Include="buildTransitive/net10.0/pixman-dotnet.targets" Pack="true" PackagePath="buildTransitive/net10.0/" />
    <None Include="buildTransitive/apple/pixman-dotnet.targets" Pack="true" PackagePath="buildTransitive/net10.0-ios26.0/;buildTransitive/net10.0-tvos26.0/;buildTransitive/net10.0-maccatalyst26.0/" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Update="$(RuntimesDir)win-x64/native/*.dll" Condition="'$(PROCESSOR_ARCHITECTURE)' != 'ARM64'" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Update="$(RuntimesDir)win-arm64/native/*.dll" Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Update="$(RuntimesDir)osx/native/*.dylib" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Update="$(RuntimesDir)linux-x64/native/*.so" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Update="$(RuntimesDir)linux-arm64/native/*.so" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Pixman.Tests</RootNamespace>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/test-packages/</RestorePackagesPath>
    <PixmanPackageVersion>$(Version)</PixmanPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pixman-dotnet" Version="$(PixmanPackageVersion)" />
    <PackageReference Include="xunit.v3" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../Pixman.NET.Tests/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)TestRunner.cs" Link="TestRunner.cs" />
  </ItemGroup>
</Project>
